      <path d="M5.3 13.5h12.2M6.5 20.5h9.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'french-press' -%}
    <svg aria-hidden="true" focusable="false" fill="none" viewBox="0 0 24 24" class="block-swatch__icon">
