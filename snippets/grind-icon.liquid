{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  GRIND ICON
  ----------------------------------------------------------------------------------------------------------------------

  Renders an SVG icon corresponding to a coffee grind type / brewing method.

  ********************************************
  Supported variables
  ********************************************

  * grind_type: the name of the grind option value (e.g. "Whole Bean", "Drip", "French Press", etc.)
{%- endcomment -%}

{%- liquid
  assign grind_handle = grind_type | downcase | strip | handle

  if grind_handle contains 'whole' or grind_handle contains 'bean'
    assign icon_type = 'whole-bean'
  elsif grind_handle contains 'drip'
    assign icon_type = 'drip'
  elsif grind_handle contains 'french' or grind_handle contains 'press'
    assign icon_type = 'french-press'
  elsif grind_handle contains 'pour'
    assign icon_type = 'pour-over'
  elsif grind_handle contains 'chemex'
    assign icon_type = 'chemex'
  elsif grind_handle contains 'cold' or grind_handle contains 'ice'
    assign icon_type = 'cold-brew'
  elsif grind_handle contains 'moka'
    assign icon_type = 'moka-pot'
  elsif grind_handle contains 'espresso'
    assign icon_type = 'espresso'
  elsif grind_handle contains 'percolator'
    assign icon_type = 'percolator'
  elsif grind_handle contains 'k-cup' or grind_handle contains 'pod' or grind_handle contains 'capsule'
    assign icon_type = 'k-cup'
  else
    assign icon_type = 'whole-bean'
  endif
-%}

{%- case icon_type -%}
  {%- when 'whole-bean' -%}
    <svg aria-hidden="true" focusable="false" fill="none" viewBox="0 0 24 24" class="block-swatch__icon">
      <ellipse cx="8.2" cy="13.2" rx="4" ry="5.5" transform="rotate(-25 8.2 13.2)" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
