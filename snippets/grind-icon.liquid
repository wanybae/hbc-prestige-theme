      <ellipse cx="16" cy="10.5" rx="3.8" ry="5.2" transform="rotate(22 16 10.5)" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M17.9 5.8c-.7 1.9-2.1 2.3-1.9 4.5.2 2.1-1.1 2.7-1.9 4.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'drip' -%}
    <svg aria-hidden="true" focusable="false" fill="none" viewBox="0 0 24 24" class="block-swatch__icon">
      <path d="M6.5 5h9.5M11.25 3.25V5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
