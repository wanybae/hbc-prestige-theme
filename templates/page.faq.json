        "question_nTQ7nj": {
          "type": "question",
          "settings": {
            "question": "Is your coffee Gluten Free?",
            "answer": "<p>While not currently certified, our ground and whole bean coffee do NOT contain any gluten or wheat ingredients. Coffee is the only product in our facilities and it never comes into contact with anything containing wheat or gluten.</p>"
          }
        },
