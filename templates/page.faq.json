        "question_PzWp6q": {
          "type": "question",
          "settings": {
            "question": "Does your flavored coffee contain Propylene Glycol?",
            "answer": "<p>Yes, our Flavored coffee does contain Propylene Glycol. Propylene glycol is a useful and food safe binding agent found in a wide variety of products across the food industry. It is overall considered a very-low toxicity substance. A small percentage of people are allergic to propylene glycol and may need to avoid products containing it. Yet for most people, the amounts regularly found in food products are considered safe. This is part of the proprietary ingredients used for the natural and artificial flavoring we use.</p>"
          }
        }
