        "question_K3HbEi": {
          "type": "question",
          "settings": {
            "question": "If your coffee Keto friendly?",
            "answer": "<p>Absolutely! We do not use sugar or sweeteners in our ground or whole bean coffee flavors, and each brewed 8oz cup has approximately 2 calories, 0g carbs and 0g sugar!</p>"
